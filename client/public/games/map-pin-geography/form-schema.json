{
  "settings": {
    "pointsPerQuestion": {
      "label": "Points per Question",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 100,
      "required": true
    },
    "timeLimitSeconds": {
      "label": "Time Limit per Question (seconds)",
      "type": "number",
      "default": 20,
      "min": 0,
      "max": 120,
      "required": true,
      "placeholder": "Set to 0 for no time limit"
    },
    "showCorrectLocationOnMiss": {
      "label": "Reveal Correct Location After a Wrong Click",
      "type": "boolean",
      "default": true
    },
    "themeColor": {
      "label": "Accent Color",
      "type": "color",
      "default": "#B8863B"
    }
  },
  "content": {
    "label": "Locations",
    "minItems": 1,
    "itemSchema": {
      "prompt": {
        "label": "Prompt shown to the student",
        "type": "textarea",
        "rows": 2,
        "required": true,
        "placeholder": "e.g. Click on the capital of Japan"
      },
      "map": {
        "label": "Map Image and Target Location",
        "type": "mapPoint",
        "accept": ["image/jpeg", "image/png", "image/webp"],
        "radiusMin": 10,
        "radiusMax": 100,
        "radiusDefault": 30
      },
      "hint": {
        "label": "Optional hint",
        "type": "text",
        "required": false,
        "placeholder": "e.g. Look along Tokyo Bay"
      }
    }
  }
}
