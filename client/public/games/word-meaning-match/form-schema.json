{
  "settings": {
    "pairsPerRound": {
      "label": "Maximum Pairs per Round",
      "type": "number",
      "default": 4,
      "min": 2,
      "max": 8,
      "required": true
    },
    "pointsPerPair": {
      "label": "Points per correct match",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 100,
      "required": true
    }
  },
  "content": {
    "label": "Vocabulary Pairs",
    "minItems": 2,
    "itemSchema": {
      "word": {
        "label": "Word / Term",
        "type": "text",
        "required": true,
        "placeholder": "e.g. Photosynthesis"
      },
      "definition": {
        "label": "Definition / Description",
        "type": "textarea",
        "rows": 2,
        "required": true,
        "placeholder": "e.g. The process by which plants use sunlight to synthesize foods."
      }
    }
  }
}