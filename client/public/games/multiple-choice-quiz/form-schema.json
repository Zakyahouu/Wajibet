{
  "settings": {
    "title": {
      "type": "text",
      "label": "Game Title",
      "required": true,
      "default": "Multiple Choice Quiz"
    },
    "timePerQuestion": {
      "type": "number",
      "label": "Time Per Question (seconds)",
      "required": false,
      "default": 30,
      "min": 0,
      "max": 300
    },
    "shuffleQuestions": {
      "type": "boolean",
      "label": "Shuffle Questions",
      "required": false,
      "default": false
    }
  },
  "content": {
    "label": "Questions",
    "minItems": 1,
    "itemSchema": {
      "question": {
        "type": "textarea",
        "label": "Question",
        "required": true,
        "rows": 3
      },
      "optionA": {
        "type": "text",
        "label": "Option A",
        "required": true
      },
      "optionB": {
        "type": "text",
        "label": "Option B",
        "required": true
      },
      "optionC": {
        "type": "text",
        "label": "Option C",
        "required": true
      },
      "optionD": {
        "type": "text",
        "label": "Option D",
        "required": false
      },
      "correct": {
        "type": "enum",
        "label": "Correct Option",
        "required": true,
        "default": "A",
        "options": [
          "A",
          "B",
          "C",
          "D"
        ]
      },
      "explanation": {
        "type": "textarea",
        "label": "Explanation (Optional)",
        "required": false,
        "rows": 2
      }
    }
  }
}