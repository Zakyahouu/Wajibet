# === Wajibet Server Environment ===
# Copy this file to server/.env and fill in the values

# --- Core ---
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/madrassaplay
JWT_SECRET=replace_me_with_a_secure_random_string
CORS_ORIGIN=http://localhost:5173

# --- Safety toggles ---
ENABLE_SCHOOL_DELETION_CRON=false
BACKUP_ON_START=false

# --- Directis360 Integration (Federated Auth) ---
FEDERATED_SECRET=replace_me_with_shared_secret
DIRECTIS_ORIGIN=http://localhost:3000

# === Wajibet Client Environment ===
# Create client/.env with:
# VITE_BACKEND_URL=http://localhost:5000
